# Supabase is optional. Leave these empty to run in demo mode:
# recipes come from the bundled seed data and personal data is kept in the browser.
#
# Find both values in your Supabase project: Settings > API.
# The anon key is safe to expose to the browser; row level security protects user data.
# Never put the service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
